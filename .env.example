APP_NAME="Poster Generator"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=3700

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- AI ----------------------------------------------------------------------
# Claude Fable runs every job and chooses the image/video models itself.
ANTHROPIC_API_KEY=
AI_AGENT_MODEL=claude-fable-5-1
AI_AGENT_EFFORT=high

# Image models (at least one)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Video models (at least one for reels)
# Seedance — BytePlus ModelArk
SEEDANCE_API_KEY=
SEEDANCE_MODEL=seedance-1-0-pro-250528
# Veo — Gemini API; uses GEMINI_API_KEY unless VEO_API_KEY is set
VEO_MODEL=veo-3.1-generate-preview
VEO_RESOLUTION=1080p

# Reel length = sum of its clips, capped here (Instagram limit)
REEL_MAX_SECONDS=180

# ffmpeg assembles the reel
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Creations / fair use -------------------------------------------------------
CREATIONS_MAX_ACTIVE=2
CREATIONS_JOB_TIMEOUT=3600
# CREATIONS_DAILY_POSTERS=
# CREATIONS_DAILY_REELS=

# --- QPay ---------------------------------------------------------------------
QPAY_BASE_URL=https://merchant.qpay.mn
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
# Public URL QPay can reach (defaults to APP_URL)
QPAY_CALLBACK_BASE=
# Local only: simulate payments without merchant credentials
QPAY_FAKE=false
